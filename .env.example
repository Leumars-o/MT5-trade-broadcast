# Copy to .env and fill in. NEVER commit .env.
# Secrets live here only — never in config.yaml, never logged, never sent.

# MetaApi (investor / read-only credentials only). Used from M4 onward.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Telegram bot (send-only). Used from M3 onward.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# External dead-man's switch ping URL (e.g. https://hc-ping.com/<uuid>).
# The bot GETs this every heartbeat; the service alerts if pings stop. Blank = off.
HEALTHCHECK_URL=
